{
  "name": "employee-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=client",
    "build:frontend": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "dev": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "npm run dev --workspace=client",
    "dev:all": "concurrently \"npm run dev --workspace=client\" \"node server.js\"",
    "start": "node server.js",
    "lint": "npm run lint --workspace=client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "validator": "^13.15.35",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
